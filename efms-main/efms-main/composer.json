{
    "name": "enterprise/financial-management-system",
    "description": "Enterprise Financial Management System (EFMS) - a lightweight, extensible PHP MVC framework for accounting, invoicing, and financial reporting.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-json": "*",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --colors=always",
        "db:init": "php database/setup.php"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
