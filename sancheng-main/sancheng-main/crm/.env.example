DB_PATH=database/crm.sqlite
APP_ENV=development

# 后台「备份与恢复」（/backup）用得到的两个目录，不改也能跑：
# UPLOAD_PATH  = 附件落盘目录（/backup 打包与恢复都认它）
# BACKUP_PATH  = 服务器快照目录（导入时能选的“服务器本地包”只来自这里）
# 磁盘紧张时把 BACKUP_PATH 换到大盘挂载点即可（它在 Web 根外，自带 .htaccess 拒访）。
#UPLOAD_PATH=public/uploads/attachments
#BACKUP_PATH=database/backups

# 自注册开关：production 环境默认关闭（注册页只提示不开通）；开发/演示默认开放。
# 要对公网开放自注册时设 1。
#ALLOW_REGISTRATION=1

# 建库时是否灌演示业务数据（商品/客户/线索/商机/订单/跟进样例）。
# 生产新库建议设 0；管理员账号与系统默认设置始终会建。
#CRM_DEMO_DATA=1

# ---- AI 助手（可选）----
# 这里的值优先于「设置 → AI 助手」，密钥放这里就不会进入数据库。
# 服务商：mock | ollama | openai | deepseek | moonshot | dashscope | zhipu | mimo | siliconflow | custom
#AI_PROVIDER=mock
#AI_ENABLED=0
#AI_MODE=preview
# 常用取值：deepseek-v4-flash / deepseek-v4-pro / qwen3.8-flash / qwen3.8-max / gpt-4o-mini
#         mimo-v2.5 / mimo-v2.5-pro（小米 MiMo；mimo-v2-* 系列已于 2026-06-30 下线，名字失效）
#         智谱 GLM：glm-5.3-flash / glm-4.7-flash / glm-5.2（GLM-5.3 系列强制开启思考，不能传
#         thinking.type=disabled；只要 provider 是 zhipu，快速模式就会发 reasoning_effort=low）
#AI_MODEL=deepseek-v4-flash
#AI_BASE_URL=https://api.openai.com/v1
# 用小米 MiMo：AI_PROVIDER=mimo，地址留空就用官方的 https://api.xiaomimimo.com/v1；
# 如果你买的是 Token Plan（不是按量付费），还要把地址换成 https://token-plan-cn.xiaomimimo.com/v1，
# 并用控制台里那把以 tp 开头的 Key（按量付费的 Key 以 sk 开头）。
#AI_API_KEY=***
